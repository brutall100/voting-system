# Copy this file to .env and change the values if you need to:
#   cp .env.example .env

# Port the local server listens on (http://localhost:3000)
PORT=3000

# Where the SQLite database file is stored (relative to the project root)
DB_FILE=data/votes.db

# Add three sample polls the first time the database is empty (true / false)
SEED_SAMPLE_POLLS=true
